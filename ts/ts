interface AuthResult {
    isAuthenticated: boolean;
    message: string;
    attemptsRemaining: number;
}

class TypeScriptAuthEngine {
    private isAuthenticated: boolean = false;
    private attempts: number = 0;
    private readonly maxAttempts: number = 3;
    private readonly masterKeys: string[] = ["369", "MAHANOKOR", "KHOEM_AI"];

    public verifyKey(inputKey: string): AuthResult {
        if (this.masterKeys.includes(inputKey)) {
            this.isAuthenticated = true;
            this.attempts = 0;
            return {
                isAuthenticated: true,
                message: "🔓 ដោះសោប្រព័ន្ធជោគជ័យតាមរយៈ TypeScript Engine!",
                attemptsRemaining: this.maxAttempts
            };
        } else {
            this.attempts++;
            const remaining = this.maxAttempts - this.attempts;
            return {
                isAuthenticated: false,
                message: `⚠️ កូដសម្ងាត់មិនត្រឹមត្រូវ! (សល់ឱកាស ${remaining} ដងទៀត)`,
                attemptsRemaining: remaining
            };
        }
    }

    public getStatus(): boolean {
        return this.isAuthenticated;
    }
}
